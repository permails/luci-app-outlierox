{
	"luci-app-outlierox": {
		"description": "Grant access to Outlierox Mesh configuration and daemon control",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"luci.outlierox": [
					"get_status",
					"get_subroutes",
					"get_settings",
					"get_logs"
				]
			},
			"uci": [ "tailscale" ]
		},
		"write": {
			"ubus": {
				"luci.outlierox": [
					"set_settings",
					"do_login",
					"do_logout",
					"setup_firewall",
					"cleanup_reset"
				]
			},
			"uci": [ "tailscale" ]
		}
	}
}
